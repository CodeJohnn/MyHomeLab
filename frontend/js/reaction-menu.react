import { useState } from 'react';
import { createRoot } from 'react-dom/client';

const reactions = [
  { type: 'laugh', label: '😂 Rir' },
  { type: 'anger', label: '😡 Raiva' },
  { type: 'sad', label: '😢 Triste' },
  { type: 'surprise', label: '😮 Surpreso' },
  { type: 'wave', label: '👋 Acenar' },
  { type: 'heart', label: '❤️ Curtir' }
];

function ReactionMenu({ onSelect }) {
  const [selected, setSelected] = useState(null);

  return <>
    <strong>Reagir</strong>
    {reactions.map(({ type, label }) => (
      <button
        key={type}
        type="button"
        aria-pressed={selected === type}
        onClick={() => {
          setSelected(type);
          onSelect(type);
        }}
      >
        {label}
      </button>
    ))}
  </>;
}

export function mountReactionMenu(container, onSelect) {
  const root = createRoot(container);
  root.render(<ReactionMenu onSelect={onSelect} />);
  return () => root.unmount();
}
